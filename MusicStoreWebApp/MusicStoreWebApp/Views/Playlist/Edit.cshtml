@using MusicStore.Api.Responses
@model PlaylistFrontendUpdateResponse
@{
    ViewBag.Title = "Update Playlist";
}

@section StyleSheets
    {
    <link href="~/css/form.css" rel="stylesheet" />
}

<div class="form-container">
    <div class="form-header">
        <p class="header-paragraph">Edit Playlist No. @Model.PlaylistResponse.PlaylistId</p>
    </div>
    <form id="main-form" class="form-content" method="post" autocomplete="off">
        <div class="form-group">
            @Html.LabelFor(p => p.PlaylistResponse.PlaylistId, "Playlist Id")
            @Html.TextBoxFor(p => p.PlaylistResponse.PlaylistId, new { @class = "form-control", disabled = "disabled" })
        </div>
        <div class="form-group">
            <label for="Name">Name<sup class="required-superscript">*</sup></label>
            @Html.TextBoxFor(p => p.PlaylistUpdateRequest.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(p => p.PlaylistUpdateRequest.Name)
        </div>
    </form>
    <hr class="break-line" />
    <div class="form-footer">
        @Html.ActionLink("Cancel", "Details", null, new { playlistId = Model.PlaylistResponse.PlaylistId }, new { @class = "btn btn-danger form-button form-cancelButton" })
        <button type="submit" class="btn btn-danger form-button form-submitButton" form="main-form">Save</button>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/playlistForm.js"></script>
}