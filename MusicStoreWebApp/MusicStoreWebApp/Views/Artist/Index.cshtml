@using MusicStoreWebApp.Models.ViewModels
@using MusicStoreWebApp.ExtensionMethods
@model IEnumerable<ArtistViewModel>
@{
    ViewBag.Title = "Available Artists";
}

@section StyleSheets
    {
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/sideBar.css" rel="stylesheet" />
    <link href="~/css/myModal.css" rel="stylesheet" />
}

@await Html.PartialAsync("SideBarView")

<div class="rightSide-content">
    <div class="functionalities-container">
        @Html.TextBox("search-text-box", null, new { @type = "search", @class = "form-control search-text-box", placeholder = "Search", autocomplete = "off" })
        <select class="filter-select" multiple="multiple">
            <option value="artistId">Artist Id</option>
            <option value="name">Name</option>
        </select>
        <div class="btn-group main-select">
            @Html.ActionLink("Create Artist", "Create", null, null, new { @class = "btn btn-danger create-button" })
            <button type="button" class="btn btn-danger dropdown-toggle dropdown-toggle-split create-button-group" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
            <div class="dropdown-menu" k, style="top: 20px;">
                <button class="dropdown-item index-delete-button" disabled>Delete Artist</button>
            </div>
        </div>
    </div>

    @(Html.Kendo().Grid<ArtistViewModel>()
                        .Name("grid")
                        .HtmlAttributes(new { style = "height: 560px" })
                        .Columns(columns =>
                        {
                            columns.Bound(artist => artist.ArtistId).Width(130).ClientTemplate(Html.ActionLink("#=ArtistId#", "Details", new { artistId = "#=ArtistId#" }).ToHtmlString());
                            columns.Bound(artist => artist.Name);
                            columns.Select().Width(70);
                        })
                        .Sortable(sortable => sortable
                            .AllowUnsort(true)
                            .SortMode(GridSortMode.MultipleColumn)
                            .ShowIndexes(true))
                        .Scrollable()
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(10)
                            .Model(model => model.Id(p => p.ArtistId))
                            .Read(read => read.Action("GridListArtists", "Artist"))
                        )
    )
    <div class="delete-plugin-container"></div>
</div>

@section Scripts
    {
    <script src="~/js/artistIndex.js" defer></script>
    <script src="~/js/DeleteModal.js" defer></script>
}