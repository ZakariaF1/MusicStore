@using MusicStoreWebApp.Models.ViewModels
@model AlbumViewModel
@{
    ViewBag.Title = "Album Details";
}

@section StyleSheets
    {
    <link href="~/css/details.css" rel="stylesheet" />
    <link href="~/css/sideBar.css" rel="stylesheet" />
    <link href="~/css/myModal.css" rel="stylesheet" />
}

@await Html.PartialAsync("SideBarView")

<div class="rightSide-content">
    <div class="header-content">
        <p class="header-paragraph">@Model.Title</p>
        <button type="button" class="btn btn-danger details-delete-button">Delete Album</button>
    </div>
    <div class="tabs-container">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                <a class="nav-item nav-link active" id="nav-home-tab" data-toggle="tab" href="#nav-home" role="tab" aria-controls="nav-home" aria-selected="true">Details</a>
            </div>
        </nav>
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
                <div class="form-group">
                    @Html.LabelFor(p => p.AlbumId, "Album Id")
                    @Html.ActionLink(Model.AlbumId.ToString(), "Edit", null, null, new { @class = "linkDisabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Title)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Title) ? "-" : Model.Title, "Edit", new { albumId = Model.AlbumId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.ArtistName, "Artist")
                    @Html.ActionLink((Model.ArtistName == null) ? "-" : Model.ArtistName, "Edit", new { albumId = Model.AlbumId }, new { @class = "linkEnabled" })
                </div>
            </div>
        </div>
    </div>
    <div class="delete-plugin-container"></div>
</div>

@section Scripts
    {
    <script src="~/js/albumDetails.js" defer></script>
    <script src="~/js/DeleteModal.js" defer></script>
}