@using MusicStore.Api.Requests.CreateRequests
@model AlbumCreateRequest
@{
    ViewBag.Title = "Create Album";
}

@section StyleSheets
    {
    <link href="~/css/form.css" rel="stylesheet" />
}

<div class="form-container">
    <div class="form-header">
        <p class="header-paragraph">Create Album</p>
    </div>
    <form id="main-form" class="form-content" method="post" autocomplete="off">
        <div class="form-group">
            <label for="Title">Title<sup class="required-superscript">*</sup></label>
            @Html.TextBoxFor(p => p.Title, new { @class = "form-control" })
            @Html.ValidationMessageFor(p => p.Title)
        </div>
        <div class="form-group">
            <label for="ArtistId">Artist<sup class="required-superscript">*</sup></label>
            @Html.TextBoxFor(p => p.ArtistId, new { @id = "artistId-input", @style = "width: 100%" })
            <span class="field-validation-error artistId-validation-error"></span>
        </div>
    </form>
    <hr class="break-line" />
    <div class="form-footer">
        <a class="btn btn-danger form-button form-cancelButton" asp-action="Index" role="button">Cancel</a>
        <button type="submit" class="btn btn-danger form-button form-submitButton" form="main-form">Create</button>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/albumForm.js"></script>
}