@using MusicStore.Api.Responses
@model MediaTypeFrontendUpdateResponse
@{
    ViewBag.Title = "Update Media Type";
}

@section StyleSheets
    {
    <link href="~/css/form.css" rel="stylesheet" />
}

<div class="form-container">
    <div class="form-header">
        <p class="header-paragraph">Edit Media Type @Model.MediaTypeResponse.Name</p>
    </div>
    <form id="main-form" class="form-content" method="post" autocomplete="off">
        <div class="form-group">
            @Html.LabelFor(p => p.MediaTypeResponse.MediaTypeId, "Media Type Id")
            @Html.TextBoxFor(p => p.MediaTypeResponse.MediaTypeId, new { @class = "form-control", disabled = "disabled" })
        </div>
        <div class="form-group">
            <label for="Name">Name<sup class="required-superscript">*</sup></label>
            @Html.TextBoxFor(p => p.MediaTypeUpdateRequest.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(p => p.MediaTypeUpdateRequest.Name)
        </div>
    </form>
    <hr class="break-line" />
    <div class="form-footer">
        @Html.ActionLink("Cancel", "Details", null, new { mediaTypeId = Model.MediaTypeResponse.MediaTypeId }, new { @class = "btn btn-danger form-button form-cancelButton" })
        <button type="submit" class="btn btn-danger form-button form-submitButton" form="main-form">Save</button>
    </div>
</div>

@section Scripts
    {
    <script src="~/js/mediaTypeForm.js"></script>
}