@using MusicStoreWebApp.Models.ViewModels
@using MusicStoreWebApp.ExtensionMethods
@model IEnumerable<TrackViewModel>
@{
    ViewBag.Title = "Available Tracks";
}

@section StyleSheets
    {
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/sideBar.css" rel="stylesheet" />
    <link href="~/css/myModal.css" rel="stylesheet" />
}

@await Html.PartialAsync("SideBarView")

<div class="rightSide-content">
    <div class="functionalities-container">
        @Html.TextBox("search-text-box", null, new { @type = "search", @class = "form-control search-text-box", placeholder = "Search", autocomplete = "off" })
        <select class="filter-select" multiple="multiple">
            <option value="trackId">Track Id</option>
            <option value="name">Name</option>
            <option value="album">Album</option>
            <option value="mediaType">Media Type</option>
            <option value="genre">Genre</option>
            <option value="composer">Composer</option>
            <option value="milliseconds">Milliseconds</option>
            <option value="bytes">Bytes</option>
            <option value="unitPrice">Unit Price</option>
        </select>
        <div class="btn-group main-select">
            @Html.ActionLink("Create Track", "Create", null, null, new { @class = "btn btn-danger create-button" })
            <button type="button" class="btn btn-danger dropdown-toggle dropdown-toggle-split create-button-group" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
            <div class="dropdown-menu" k, style="top: 20px;">
                <button class="dropdown-item index-delete-button" disabled>Delete Track</button>
            </div>
        </div>
    </div>

    @(Html.Kendo().Grid<TrackViewModel>()
                        .Name("grid")
                        .HtmlAttributes(new { style = "height: 560px" })
                        .Columns(columns =>
                        {
                            columns.Bound(track => track.TrackId).ClientTemplate(Html.ActionLink("#=TrackId#", "Details", new { TrackId = "#=TrackId#" }).ToHtmlString());
                            columns.Bound(track => track.Name);
                            columns.Bound(track => track.AlbumTitle);
                            columns.Bound(track => track.MediaTypeName);
                            columns.Bound(track => track.GenreName);
                            columns.Bound(track => track.Composer);
                            columns.Bound(track => track.Milliseconds);
                            columns.Bound(track => track.Bytes);
                            columns.Bound(track => track.UnitPrice);
                            columns.Select().Width(70);
                        })
                        .Sortable(sortable => sortable
                            .AllowUnsort(true)
                            .SortMode(GridSortMode.MultipleColumn)
                            .ShowIndexes(true))
                        .Scrollable()
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(10)
                            .Model(model => model.Id(p => p.TrackId))
                            .Read(read => read.Action("GridListTracks", "Track"))
                        )
    )
    <div class="delete-plugin-container"></div>
</div>

@section Scripts
    {
    <script src="~/js/trackIndex.js" defer></script>
    <script src="~/js/DeleteModal.js" defer></script>
}