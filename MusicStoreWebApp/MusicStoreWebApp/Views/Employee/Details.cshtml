@using MusicStoreWebApp.Models.ViewModels
@model EmployeeViewModel
@{
    ViewBag.Title = "Employee Details";
}

@section StyleSheets
    {
    <link href="~/css/details.css" rel="stylesheet" />
    <link href="~/css/sideBar.css" rel="stylesheet" />
    <link href="~/css/myModal.css" rel="stylesheet" />
}

@await Html.PartialAsync("SideBarView")

<div class="rightSide-content">
    <div class="header-content">
        <p class="header-paragraph">@Model.FullName</p>
        <button type="button" class="btn btn-danger details-delete-button">Delete Employee</button>
    </div>
    <div class="tabs-container">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                <a class="nav-item nav-link active" id="nav-home-tab" data-toggle="tab" href="#nav-home" role="tab" aria-controls="nav-home" aria-selected="true">Details</a>
            </div>
        </nav>
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
                <div class="form-group">
                    @Html.LabelFor(p => p.EmployeeId, "Employee Id")
                    @Html.ActionLink(Model.EmployeeId.ToString(), "Edit", null, null, new { @class = "linkDisabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.FirstName, "First Name")
                    @Html.ActionLink(String.IsNullOrEmpty(Model.FirstName) ? "-" : Model.FirstName, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.LastName, "Last Name")
                    @Html.ActionLink(String.IsNullOrEmpty(Model.LastName) ? "-" : Model.LastName, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Title)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Title) ? "-" : Model.Title, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.ReportsTo)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.ReportsTo) ? "-" : Model.ReportsTo, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.BirthDate, "Birth Date")
                    @Html.ActionLink(String.IsNullOrEmpty(Model.BirthDate) ? "-" : Model.BirthDate, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.HireDate, "Hire Date")
                    @Html.ActionLink(String.IsNullOrEmpty(Model.HireDate) ? "-" : Model.HireDate, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Address)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Address) ? "-" : Model.Address, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Country)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Country) ? "-" : Model.Country, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.City)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.City) ? "-" : Model.City, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.State)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.State) ? "-" : Model.State, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.PostalCode, "Postal Code")
                    @Html.ActionLink(String.IsNullOrEmpty(Model.PostalCode) ? "-" : Model.PostalCode, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Phone)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(p => p.Fax)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Fax) ? "-" : Model.Fax, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(p => p.Email)
                    @Html.ActionLink(String.IsNullOrEmpty(Model.Email) ? "-" : Model.Email, "Edit", new { employeeId = Model.EmployeeId }, new { @class = "linkEnabled" })
                </div>
            </div>
        </div>
    </div>
    <div class="delete-plugin-container"></div>
</div>

@section Scripts
    {
    <script src="~/js/employeeDetails.js" defer></script>
    <script src="~/js/DeleteModal.js" defer></script>
}