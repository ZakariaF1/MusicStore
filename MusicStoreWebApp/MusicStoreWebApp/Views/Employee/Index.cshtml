@using MusicStoreWebApp.Models.ViewModels
@using MusicStoreWebApp.ExtensionMethods
@model IEnumerable<EmployeeViewModel>
@{
    ViewBag.Title = "Available Employees";
}

@section StyleSheets
    {
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/sideBar.css" rel="stylesheet" />
    <link href="~/css/myModal.css" rel="stylesheet" />
}

@await Html.PartialAsync("SideBarView")

<div class="rightSide-content">
    <div class="functionalities-container">
        @Html.TextBox("search-text-box", null, new { @type = "search", @class = "form-control search-text-box", placeholder = "Search", autocomplete = "off" })
        <select class="filter-select" multiple="multiple">
            <option value="employeeId">Employee Id</option>
            <option value="fullName">Full Name</option>
            <option value="title">Title</option>
            <option value="phone">Phone</option>
            <option value="email">Email</option>
        </select>
        <div class="btn-group main-select">
            @Html.ActionLink("Create Employee", "Create", null, null, new { @class = "btn btn-danger create-button" })
            <button type="button" class="btn btn-danger dropdown-toggle dropdown-toggle-split create-button-group" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
            <div class="dropdown-menu" k, style="top: 20px;">
                <button class="dropdown-item index-delete-button" disabled>Delete Employee</button>
            </div>
        </div>
    </div>

    @(Html.Kendo().Grid<EmployeeViewModel>()
        .Name("grid")
        .HtmlAttributes(new { style = "height: 560px" })
        .Columns(columns =>
        {
            columns.Bound(employee => employee.EmployeeId).Width(150).ToString();
            columns.Bound(c => c.FullName).ClientTemplate(Html.ActionLink("#=FullName#", "Details", new { employeeId = "#=EmployeeId#" }).ToHtmlString());
            columns.Bound(employee => employee.Title);
            columns.Bound(employee => employee.Phone);
            columns.Bound(employee => employee.Email);
            columns.Select().Width(70);
        })
        .Sortable(sortable => sortable
            .AllowUnsort(true)
            .SortMode(GridSortMode.MultipleColumn)
            .ShowIndexes(true))
        .Scrollable()
        .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model => model.Id(p => p.EmployeeId))
            .Read(read => read.Action("GridListEmployees", "Employee"))
        )
    )
    <div class="delete-plugin-container"></div>
</div>

@section Scripts
    {
    <script src="~/js/employeeIndex.js" defer></script>
    <script src="~/js/DeleteModal.js" defer></script>
}