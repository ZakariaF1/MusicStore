@model IEnumerable<MusicStore.Api.Responses.EmployeeResponse>
@using MusicStore
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Kendo.Mvc
@using Kendo.Mvc.UI

<script src="JavaScript/GetEmployees.js"></script>

@{
    ViewBag.Title = "EmployeesList";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

@(Html.Kendo().Grid<MusicStore.Api.Responses.EmployeeResponse>()
                            .Name("grid")
                            .Columns(columns =>
                            {
                                columns.Select();
                                columns.Bound(c => c.EmployeeId);
                                columns.Bound(c => c.FirstName);
                                columns.Bound(c => c.LastName);
                                columns.Bound(c => c.Title);
                                columns.Bound(c => c.ReportsTo);
                                columns.Bound(c => c.HireDate);
                                columns.Bound(c => c.Country);
                            })
                            .HtmlAttributes(new { style = "height: 380px;" })
                            .Scrollable()
                            .Sortable()
                            .Filterable()
                            .Selectable()
                            .PersistSelection()
                            .Pageable(pageable => pageable
                                .Refresh(true)
                                .PageSizes(true)
                                .ButtonCount(5))
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Read(read => read.Action("EmployeesIndex", "Employee"))
                            )
)